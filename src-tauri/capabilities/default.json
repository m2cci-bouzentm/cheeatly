{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main", "settings", "model-selector", "preferences"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "os:default",
    "opener:default",
    "dialog:default",
    "process:default",
    "shell:allow-open",
    "global-shortcut:default"
  ]
}
