{
  "name": "cheatly",
  "version": "0.0.1",
  "description": "Cheatly is a meeting notes app that uses AI to generate notes from your meetings.",
  "scripts": {
    "clean": "rimraf dist src-tauri/target",
    "dev": "vite",
    "build:frontend": "tsc && vite build",
    "build": "npm run build:frontend",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:prepare": "node scripts/prepare-tauri-sidecar.js",
    "tauri:dev": "npm run tauri:prepare && tauri dev",
    "tauri:build": "npm run tauri:prepare && tauri build",
    "tauri:check": "PATH=/opt/homebrew/opt/rustup/bin:$PATH cargo check --manifest-path src-tauri/Cargo.toml",
    "start": "npm run tauri:dev",
    "dist": "npm run tauri:build",
    "format": "prettier --write \"{src,scripts,tests}/**/*.{ts,tsx,js,jsx,mjs,cjs,json,md}\" \"*.{json,js,cjs,mjs,ts,md}\"",
    "format:check": "prettier --check \"{src,scripts,tests}/**/*.{ts,tsx,js,jsx,mjs,cjs,json,md}\" \"*.{json,js,cjs,mjs,ts,md}\"",
    "test": "npm run test:unit && npm run test:rust && npm run test:e2e",
    "test:unit": "node --test $(find src/test -name \"*.test.mjs\")",
    "test:rust": "PATH=/opt/homebrew/opt/rustup/bin:$PATH cargo test --workspace",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "doctor": "npx react-doctor@latest",
    "test:stt": "pkill -f speech-to-text 2>/dev/null || true; node --test --test-concurrency=1 tests/stt/parakeet.e2e.test.mjs",
    "test:native:drag": "scripts/native-tests/window-drag.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prettier": "^3.8.4",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.15",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.200",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-switch": "^1.3.0",
    "@radix-ui/react-toast": "^1.2.2",
    "@tanstack/react-query": "^5.100.10",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-os": "^2.4.0",
    "ai": "^6.0.198",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.29.2",
    "jspdf": "^4.0.0",
    "katex": "^0.16.27",
    "lucide-react": "^0.460.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^15.6.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^2.5.4"
  },
  "overrides": {}
}
